# Runtime data — machine-specific state, never source
events.jsonl
agent-workspaces/
*.jsonl
# WS decode fixtures are the exception: they are checked-in test evidence
# (live-captured API frames, scripts/ws_decode_check.sh). The negation must
# come AFTER *.jsonl — in gitignore the LAST matching pattern wins, and a
# silently-ignored fixture means the decode check "passes" on zero files in
# a fresh clone.
!ios-app/tests/fixtures/ws_frames/*.jsonl
agents.json
projects.json
serving.json
vllm.json
cluster.json
cluster-manifest.json
setup.json
plugin-state/
# Embedding-model cache — 87 MB of ONNX weights (models--Qdrant--all-MiniLM-L6-v2-onnx).
# Written by the Rust `fastembed` crate vendored inside the memori SDK: that binary
# carries the `.fastembed_cache` default and honours FASTEMBED_CACHE_DIR, and
# memori_byodb/_client.py is what loads the SDK. The cache path is resolved under the
# *current* directory, so the download lands in whichever repo an agent or test run
# happens to cwd in — the same 87 MB sits at 7 different roots on this host (hscc,
# gateclerk, ecofire-bc). No repo code mentions fastembed, so a repo can only refuse
# the commit: ignore it, and do not delete it — re-fetching costs bandwidth and time.
.fastembed_cache/

# Sensitive files — credentials / private machine data
hf_token
setup.json
*password*
*secret*
*.token

# Version tracking (root only — anchored: an unanchored 'VERSION' also
# shadowed scripts/tests/fixtures/readme_lint/*/VERSION, silently dropping
# them from git and making test_readme_lint fail on any clean checkout)
/VERSION

# Python bytecode
__pycache__/
*.pyc

# IDE
.idea/
.vscode/
.DS_Store

# Scratch review notes
hscc-*/REVIEW-*.md

# Per-card worker working notes — never project documentation. Keep these out
# of the repo entirely (write to a non-repo scratch dir); this is a backstop so
# an accidental write at the repo root is never committed to this PUBLIC repo.
REPORT_*.md
ARTIFACT_t_*.md

# Generated audit output — a pure function of the tree (see the decision note
# in docs/audits/PR33-FOLLOWUPS-t_36580090.md). Regenerate on demand:
#   HSCC_CLI_HELP_WRITE_ARTIFACT=1 pytest scripts/tests/test_cli_help_surface.py -k artifact
#   python scripts/hscc_cli_help_audit.py --json docs/audits/artifacts/CLI_HELP_FINDINGS.json
docs/audits/artifacts/

# Python build artifacts
*.egg-info/
build/
dist/

# Internal design docs — kept local, not tracked
docs/superpowers/

# git worktrees used by the kanban dispatcher
.worktrees/
ios-app/HSCC.xcodeproj/

# Stray worker worktrees created inside the repo root (t_3e152ac7 did this).
# They are registered git worktrees, not project content — never commit them.
wt/

# PVB protocol-violation-bound test's fake HERMES_HOME (test_protocol_violation_bound.py:54)
# — should be moved to a self-cleaning temp dir; ignore in the interim (t_a52ab9f4).
*_pvb_tmp_home*/
*.sqlite
*.sqlite3

# SQLite sidecars — the companions a WAL-mode (or rollback-journal) connection
# writes next to the db. `*.sqlite` above does NOT match them, so before these
# three an `add -A` swept -wal/-shm/-journal into a commit while the base file
# stayed ignored: the same hazard PR #275 fixed, still live (t_4e553569).
# All five sqlite rules belong together — do not scatter them.
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
