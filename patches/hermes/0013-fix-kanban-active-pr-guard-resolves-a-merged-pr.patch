+++ b/tests/hermes_cli/test_kanban_active_pr_merge_resolve.py
@@ -0,0 +1,259 @@
+"""``active_pr`` respawn guard resolves a MERGED PR instead of holding forever.
+
+The guard is deliberately DB-only; this file pins the dispatcher-side
+resolution: a held card whose PR GitHub reports ``MERGED`` is completed (or
+blocked ``needs_input`` when completion is refused), ``OPEN``/``CLOSED``/
+``UNKNOWN`` keep holding, dry runs never probe, the probe is TTL-cached, and
+the ``respawn_guarded`` diagnostic is written once instead of once per tick.
+
+``gh`` is never invoked: every case fakes the ``_pr_state_fn`` seam (or the
+acceptance module's ``_api`` for D1's own mapping).
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_dispatch as kbd
+from hermes_cli import kanban_pr_acceptance as kpa
+
+PR = "https://github.com/example/repo/pull/44"
+
+
+@pytest.fixture
+def kanban_home(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Path:
+    """Isolated HERMES_HOME with an empty kanban DB and a clean probe cache."""
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    kb.init_db()
+    kbd._PR_STATE_TTL_CACHE.clear()
+    yield home
+    kbd._PR_STATE_TTL_CACHE.clear()
+
+
+@pytest.fixture(autouse=True)
+def _profile_ok(monkeypatch: pytest.MonkeyPatch) -> None:
+    import hermes_cli.config as cfgmod
+    import hermes_cli.profiles as profmod
+
+    monkeypatch.setattr(profmod, "profile_exists", lambda name: True)
+    monkeypatch.setattr(cfgmod, "load_config", lambda *a, **k: {})
+
+
+def _install_state(monkeypatch: pytest.MonkeyPatch, state, calls: list) -> None:
+    def _fn(url: str, *, assignee=None):
+        calls.append((url, assignee))
+        if isinstance(state, Exception):
+            raise state
+        return state
+
+    monkeypatch.setattr(kbd, "_pr_state_fn", lambda: _fn)
+
+
+def _card_with_pr(conn, title: str = "already PRed") -> str:
+    tid = kb.create_task(conn, title=title, assignee="dev")
+    kb.add_comment(conn, tid, author="dev", body=f"Opened {PR} for review.")
+    return tid
+
+
+def _events(conn, tid: str, kind: str | None = None) -> list[tuple[str, dict | None]]:
+    rows = conn.execute(
+        "SELECT kind, payload FROM task_events WHERE task_id = ? ORDER BY id", (tid,)
+    ).fetchall()
+    out = [(r["kind"], json.loads(r["payload"]) if r["payload"] else None) for r in rows]
+    return out if kind is None else [e for e in out if e[0] == kind]
+
+
+def _status(conn, tid: str) -> str:
+    return conn.execute("SELECT status FROM tasks WHERE id = ?", (tid,)).fetchone()["status"]
+
+
+def _tick(conn, **kwargs):
+    return kbd.dispatch_once(conn, **kwargs)
+
+
+def test_merged_pr_completes_the_ready_card(kanban_home: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    calls: list = []
+    _install_state(monkeypatch, "MERGED", calls)
+    spawned: list = []
+
+    with kbc.connect() as conn:
+        tid = _card_with_pr(conn)
+        assert kbd.check_respawn_guard(conn, tid) == "active_pr"
+
+        res = _tick(conn, spawn_fn=lambda *a, **k: spawned.append(a))
+
+        assert spawned == []
+        assert tid not in [s[0] for s in res.spawned]
+        assert _status(conn, tid) == "done"
+        resolved = _events(conn, tid, "active_pr_resolved")
+        assert len(resolved) == 1
+        assert resolved[0][1] == {"pr": PR, "state": "MERGED", "action": "completed"}
+
+
+def test_second_tick_after_resolution_writes_nothing(kanban_home: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    calls: list = []
+    _install_state(monkeypatch, "MERGED", calls)
+
+    with kbc.connect() as conn:
+        tid = _card_with_pr(conn)
+        assert _tick(conn).spawned == []
+        before = _events(conn, tid)
+
+        res = _tick(conn)
+        assert res.spawned == []
+        assert _events(conn, tid) == before
+        assert len(_events(conn, tid, "active_pr_resolved")) == 1
+
+
+def test_open_pr_keeps_holding(kanban_home: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    calls: list = []
+    _install_state(monkeypatch, "OPEN", calls)
+
+    with kbc.connect() as conn:
+        tid = _card_with_pr(conn)
+        res = _tick(conn)
+
+        assert res.spawned == []
+        assert dict(res.respawn_guarded).get(tid) == "active_pr"
+        assert _status(conn, tid) == "ready"
+        assert _events(conn, tid, "active_pr_resolved") == []
+
+
+@pytest.mark.parametrize("state", ["WAT", RuntimeError("gh exploded")])
+def test_unreadable_pr_state_fails_closed(
+    kanban_home: Path, monkeypatch: pytest.MonkeyPatch, state
+) -> None:
+    """Fail closed: ``UNKNOWN`` must never resolve a card.
+
+    A garbage answer and a raising seam stand in for the real function's
+    ``UNKNOWN`` (auth/transport/shape). The seam-unavailable case (``None``)
+    is covered separately below.
+    """
+    calls: list = []
+    _install_state(monkeypatch, state, calls)
+
+    with kbc.connect() as conn:
+        tid = _card_with_pr(conn)
+        res = _tick(conn)
+
+        assert res.spawned == []
+        assert dict(res.respawn_guarded).get(tid) == "active_pr"
+        assert _status(conn, tid) == "ready"
+        assert _events(conn, tid, "active_pr_resolved") == []
+
+
+def test_seam_unavailable_fails_closed(kanban_home: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setattr(kbd, "_pr_state_fn", lambda: None)
+
+    with kbc.connect() as conn:
+        tid = _card_with_pr(conn)
+        res = _tick(conn)
+
+        assert res.spawned == []
+        assert dict(res.respawn_guarded).get(tid) == "active_pr"
+        assert _status(conn, tid) == "ready"
+        assert _events(conn, tid, "active_pr_resolved") == []
+
+
+def test_resolved_event_is_a_terminal_hold(kanban_home: Path) -> None:
+    """D5: a failed resolution can never re-enter the spawn path.
+
+    The card keeps a fresh PR comment (inside the guard window) and carries an
+    ``active_pr_resolved`` event at/after it — e.g. the completion failed and
+    the block did not stick. The guard must name the new terminal reason, and
+    no tick may spawn it even if the PR now reads MERGED again.
+    """
+    calls: list = []
+    with kbc.connect() as conn:
+        tid = _card_with_pr(conn)
+        with kb.write_txn(conn):
+            kb._append_event(conn, tid, "active_pr_resolved",
+                             {"pr": PR, "state": "MERGED", "action": "blocked"})
+
+        assert kbd.check_respawn_guard(conn, tid) == "active_pr_resolved"
+        res = _tick(conn, spawn_fn=lambda *a, **k: calls.append(a))
+        assert res.spawned == []
+        assert dict(res.respawn_guarded).get(tid) == "active_pr_resolved"
+
+
+def test_dry_run_never_probes_or_mutates(kanban_home: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    calls: list = []
+    _install_state(monkeypatch, "MERGED", calls)
+
+    with kbc.connect() as conn:
+        tid = _card_with_pr(conn)
+        before = _events(conn, tid)
+
+        res = _tick(conn, dry_run=True)
+
+        assert calls == []
+        assert tid not in [s[0] for s in res.spawned]
+        assert dict(res.respawn_guarded).get(tid) == "active_pr"
+        assert _status(conn, tid) == "ready"
+        assert _events(conn, tid) == before
+
+
+def test_probe_is_cached_across_ticks(kanban_home: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    calls: list = []
+    _install_state(monkeypatch, "OPEN", calls)
+
+    with kbc.connect() as conn:
+        _card_with_pr(conn)
+        assert _tick(conn).spawned == []
+        assert _tick(conn).spawned == []
+
+        assert [c[0] for c in calls] == [PR]
+
+
+def test_guarded_event_is_written_once_not_per_tick(kanban_home: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    """D6: the DB diagnostic is deduped; the in-memory bucket still reports."""
+    calls: list = []
+    _install_state(monkeypatch, "CLOSED", calls)
+
+    with kbc.connect() as conn:
+        tid = _card_with_pr(conn)
+        first = _tick(conn)
+        second = _tick(conn)
+
+        assert dict(first.respawn_guarded).get(tid) == "active_pr"
+        assert dict(second.respawn_guarded).get(tid) == "active_pr"
+        assert len(_events(conn, tid, "respawn_guarded")) == 1
+
+
+def test_pr_merge_state_maps_github_answer_and_fails_closed(monkeypatch: pytest.MonkeyPatch) -> None:
+    """D1: the evidence read returns only known states; anything else is UNKNOWN."""
+    seen: dict = {}
+
+    def _fake_api(endpoint, *, query=None, paginate=False, profile_home=None):
+        seen.update(endpoint=endpoint, query=query, profile_home=profile_home)
+        return {"data": {"repository": {"pullRequest": {
+            "state": "MERGED", "mergedAt": "2026-11-23T12:00:00Z",
+            "mergeCommit": {"oid": "a" * 40},
+        }}}}
+
+    monkeypatch.setattr(kpa, "_assignee_profile_home", lambda assignee: "/profile/home")
+    monkeypatch.setattr(kpa, "_api", _fake_api)
+
+    assert kpa.pr_merge_state(PR, assignee="dev") == "MERGED"
+    assert seen["endpoint"] == "graphql"
+    assert "mergeCommit" in seen["query"] and "example" in seen["query"]
+    assert seen["profile_home"] == "/profile/home"
+
+    monkeypatch.setattr(kpa, "_api", lambda *a, **k: {"data": {"repository": None}})
+    assert kpa.pr_merge_state(PR, assignee="dev") == "UNKNOWN"
+
+    def _denied(*a, **k):
+        raise kpa._GateAuthError("HTTP 403 on graphql")
+
+    monkeypatch.setattr(kpa, "_api", _denied)
+    assert kpa.pr_merge_state(PR, assignee="dev") == "UNKNOWN"
+
+    assert kpa.pr_merge_state("https://github.com/example/repo/issues/44") == "UNKNOWN"
