+def _pr_state_fn() -> Optional[Callable[..., str]]:
+    """``kanban_pr_acceptance.pr_merge_state``, or ``None`` when it cannot be
+    imported (local import avoids a cycle; callers treat that as ``UNKNOWN``
+    and keep holding the card). Tests monkeypatch this seam, so no test ever
+    shells out to ``gh``."""
+    try:
+        from hermes_cli.kanban_pr_acceptance import pr_merge_state
+    except Exception:
+        return None
+    return pr_merge_state
+
+
+def _guarded_pr_url(conn: sqlite3.Connection, task_id: str) -> Optional[str]:
+    """Newest PR URL that made :func:`check_respawn_guard` return ``active_pr``,
+    read under exactly that function's window/unreadable-time rules."""
+    now = int(time.time())
+    newest: Optional[tuple[int, str]] = None
+    for t, comment in _rows_since(conn, "task_comments", task_id, now - _RESPAWN_GUARD_PR_WINDOW,
+                                  cols=", body", unreadable=now):
+        match = _RESPAWN_GUARD_PR_URL_RE.search(_kb._lossy_text(comment["body"]) or "")
+        if match and (newest is None or t >= newest[0]):
+            newest = (t, match.group(0))
+    return newest[1] if newest is not None else None
+
+
+def _pr_merge_state(url: str, *, assignee: Optional[str]) -> str:
+    """Cached :func:`pr_merge_state` for ``url``; ``UNKNOWN`` when unavailable.
+
+    ``UNKNOWN`` is cached too: the guard holds either way, and a broken login
+    must not be hammered once per tick. Fail closed — only ``MERGED`` resolves.
+    """
+    now = time.time()
+    hit = _PR_STATE_TTL_CACHE.get(url)
+    if hit is not None and now - hit[0] < _PR_STATE_TTL_SECONDS:
+        return hit[1]
+    state_fn = _pr_state_fn()
+    if state_fn is None:
+        return "UNKNOWN"
+    try:
+        state = state_fn(url, assignee=assignee)
+    except Exception:
+        state = "UNKNOWN"
+    if state not in ("MERGED", "OPEN", "CLOSED"):
+        state = "UNKNOWN"
+    _PR_STATE_TTL_CACHE[url] = (now, state)
+    return state
+
+
+def _resolve_merged_active_pr(conn: sqlite3.Connection, task_id: str, url: str,
+                              assignee: Optional[str]) -> bool:
+    """Resolve a card the ``active_pr`` guard is holding whose PR is MERGED.
+
+    Completes it (``done means merged``); if completion is refused or raises,
+    blocks it ``needs_input`` — never ``dependency``, which ``recompute_ready``
+    could promote back into the spawn path. Either way writes
+    ``active_pr_resolved`` so :func:`check_respawn_guard` holds it terminally.
+    True when the card left the spawn path this tick.
+    """
+    if _pr_merge_state(url, assignee=assignee) != "MERGED":
+        return False
+    action = "completed"
+    try:
+        completed = _kb.complete_task(
+            conn, task_id, summary=f"PR {url} merged (sha unavailable) — dispatcher closed "
+                                   "the card instead of re-spawning against a merged PR.",
+            metadata={"resolved_by": "dispatcher_active_pr_merged", "pr": url},
+        )
+    except Exception:
+        completed = False
+    if not completed:
+        action = "blocked"
+        try:
+            _kb.block_task(conn, task_id, kind="needs_input",
+                           reason=f"active_pr: PR {url} is MERGED; card left for an operator to close")
+        except Exception:
+            pass
+    with _kb.write_txn(conn):
+        _kb._append_event(conn, task_id, "active_pr_resolved",
+                          {"pr": url, "state": "MERGED", "action": action})
+    return True
+
