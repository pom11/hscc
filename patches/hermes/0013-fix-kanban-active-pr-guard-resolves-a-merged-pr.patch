+def pr_merge_state(url: str, *, assignee: str | None = None) -> str:
+    """``MERGED``/``OPEN``/``CLOSED`` for an exact PR URL, else ``UNKNOWN``.
+
+    Dispatcher evidence for the ``active_pr`` respawn guard, not an acceptance
+    gate: one cheapest-possible GraphQL read (state + merge evidence) through
+    this module's ``gh`` transport, so it runs as the card's assignee profile
+    (:func:`_assignee_profile_home`) and inherits the 30 s timeout. Every
+    failure — auth, transport, shape, unparseable state — collapses to
+    ``UNKNOWN``: the caller must fail closed and keep holding the card, never
+    resolve one on evidence it could not read.
+    """
+    match = _PR.fullmatch(url or "")
+    if not match:
+        return "UNKNOWN"
+    repo, number = match[1], int(match[2])
+    owner, name = repo.split("/")
+    query = (f'{{repository(owner:{json.dumps(owner)},name:{json.dumps(name)})'
+             f'{{pullRequest(number:{number:d}){{state mergedAt mergeCommit{{oid}}}}}}}}')
+    try:
+        data = _api("graphql", query=query, profile_home=_assignee_profile_home(assignee))
+        state = data["data"]["repository"]["pullRequest"]["state"]
+    except Exception:
+        return "UNKNOWN"
+    if not isinstance(state, str):
+        return "UNKNOWN"
+    state = state.upper()
+    return state if state in {"MERGED", "OPEN", "CLOSED"} else "UNKNOWN"
+
+
 def collect_acceptance(contract: str, published_pr: str | None,
