From 59b531295324225c5f999afb48b445f3074a6559 Mon Sep 17 00:00:00 2001
From: pom11 <parsecoriginalmastercraft@gmail.com>
Date: Fri, 12 Jun 2026 23:34:22 +0300
Subject: [PATCH 8/9] feat(kanban): pre_kanban_dispatch hook on re-claim
 (run_id>1)

---
 hermes_cli/kanban_db.py | 20 +++++++++++++++++++-
 hermes_cli/plugins.py   |  6 ++++++
 2 files changed, 25 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_db.py b/hermes_cli/kanban_db.py
index 4bcf817c8..ebbe16843 100644
--- a/hermes_cli/kanban_db.py
+++ b/hermes_cli/kanban_db.py
@@ -3080,7 +3080,25 @@ def claim_task(
             {"lock": lock, "expires": expires, "run_id": run_id},
             run_id=run_id,
         )
-        return get_task(conn, task_id)
+        claimed_task = get_task(conn, task_id)
+
+    # pre_kanban_dispatch hook — fired AFTER the claim commits (outside the
+    # write txn) so a handler may inspect/annotate the task before the worker
+    # reads its context. Only fires on a RE-dispatch (run_id > 1, i.e. a prior
+    # attempt exists) so the common first-claim path is untouched and adds no
+    # overhead. Handlers are best-effort: a failing/absent hook never blocks the
+    # claim. HSCC uses this to post an idempotent-resume comment (the resume
+    # probe) that build_worker_context surfaces to the worker.
+    if run_id and run_id > 1:
+        try:
+            from hermes_cli.plugins import invoke_hook as _invoke_hook
+            _invoke_hook(
+                "pre_kanban_dispatch",
+                task_id=task_id, run_id=run_id, task=claimed_task, db_path=None,
+            )
+        except Exception:
+            pass  # never let a hook failure break dispatch
+    return claimed_task
 
 
 def claim_review_task(
diff --git a/hermes_cli/plugins.py b/hermes_cli/plugins.py
index d5cb7e8fe..b9c134624 100644
--- a/hermes_cli/plugins.py
+++ b/hermes_cli/plugins.py
@@ -167,6 +167,12 @@ VALID_HOOKS: Set[str] = {
     #   choice: "once" | "session" | "always" | "deny" | "timeout"
     "pre_approval_request",
     "post_approval_response",
+    # Kanban re-dispatch hook. Fired by kanban_db.claim_task AFTER a task is
+    # re-claimed (run_id > 1 — a prior attempt exists), outside the write txn.
+    # Observers may annotate the task (e.g. post a comment) before the worker
+    # reads build_worker_context. Return values are ignored; failures never
+    # block the claim. Kwargs: task_id: str, run_id: int, task: Task, db_path.
+    "pre_kanban_dispatch",
 }
 
 ENTRY_POINTS_GROUP = "hermes_agent.plugins"
