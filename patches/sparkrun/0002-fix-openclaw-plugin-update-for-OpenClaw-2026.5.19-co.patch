From 37a7bdbe5f87002a12385f84a97de40e07dd77e2 Mon Sep 17 00:00:00 2001
From: pom11 <parsecoriginalmastercraft@gmail.com>
Date: Thu, 21 May 2026 14:51:51 +0300
Subject: [PATCH 2/2] fix(openclaw-plugin): update for OpenClaw 2026.5.19
 compatibility

- Change execute signature to match new plugin API (_id, params)
- Add TypeScript compilation (dist/index.js) as main entry
- Add @sinclair/typebox dependency, node types for tsconfig

Co-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>
---
 sparkrun-openclaw-plugin/index.ts      | 7 ++++---
 sparkrun-openclaw-plugin/package.json  | 8 ++++++--
 sparkrun-openclaw-plugin/tsconfig.json | 3 ++-
 3 files changed, 12 insertions(+), 6 deletions(-)

diff --git a/sparkrun-openclaw-plugin/index.ts b/sparkrun-openclaw-plugin/index.ts
index a4fba3b..0806e9d 100644
--- a/sparkrun-openclaw-plugin/index.ts
+++ b/sparkrun-openclaw-plugin/index.ts
@@ -29,10 +29,11 @@ export default definePluginEntry({
                     }),
                 ),
             }),
-            // @ts-ignore
-            execute: async ({command, timeout}) => {
+            execute: async (_id: string, params: Record<string, unknown>) => {
+                const command = params.command as string;
+                const timeout = params.timeout as number | undefined;
                 // Ensure the command starts with sparkrun for safety
-                const trimmed = command.trim();
+                const trimmed = (command ?? "").trim();
                 if (!trimmed.startsWith("sparkrun")) {
                     return {
                         content: [
diff --git a/sparkrun-openclaw-plugin/package.json b/sparkrun-openclaw-plugin/package.json
index a990838..9c05555 100644
--- a/sparkrun-openclaw-plugin/package.json
+++ b/sparkrun-openclaw-plugin/package.json
@@ -3,7 +3,7 @@
   "version": "0.0.1",
   "description": "AI-assisted inference on NVIDIA DGX Spark - run, manage, and stop LLM workloads with OpenClaw",
   "type": "module",
-  "main": "index.ts",
+  "main": "dist/index.js",
   "author": {
     "name": "scitrera.ai",
     "email": "open-source-team@scitrera.com"
@@ -45,6 +45,10 @@
     "LICENSE"
   ],
   "devDependencies": {
-    "@types/node": "^25.6.0"
+    "@types/node": "^25.6.0",
+    "typescript": "^6.0.3"
+  },
+  "dependencies": {
+    "@sinclair/typebox": "^0.34.49"
   }
 }
diff --git a/sparkrun-openclaw-plugin/tsconfig.json b/sparkrun-openclaw-plugin/tsconfig.json
index eb40803..6fe1a69 100644
--- a/sparkrun-openclaw-plugin/tsconfig.json
+++ b/sparkrun-openclaw-plugin/tsconfig.json
@@ -6,7 +6,8 @@
     "strict": true,
     "esModuleInterop": true,
     "skipLibCheck": true,
-    "outDir": "dist"
+    "outDir": "dist",
+    "types": ["node"]
   },
   "include": ["index.ts"]
 }
