# HSCC Configuration
# 
# Secrets are NOT stored here. Use SSH agent for auth,
# Hermes device.json for gateway auth.
#
# This file is generated by `hscc init` — edit values after init.

cluster:
  primary: 10.0.0.246    # Main model node (where vLLM runs)
  nodes: [10.0.0.244, 10.0.0.246, 10.0.0.247, 10.0.0.248]
  nas: 10.0.0.249        # NAS (model cache source)
  ssh_user: spark
  ssh_key: ~/.ssh/id_ed25519
  # Known hosts (pre-seeded to avoid MITM prompts)
  known_hosts: ~/.ssh/known_hosts

models:
  primary: "Qwen/Qwen3.6-35B-A3B-FP8"
  cache_path: "/home/spark/.cache/huggingface/hub"
  # Model ID in HF Hub format
  repo_id: "models--Qwen--Qwen3.6-35B-A3B-FP8"
  min_gpu_gb: 40

gateway:
  host: localhost
  port: 18789

daemon:
  auto_start: true              # Auto-start via launchd (macOS) / systemd --user (Linux)
  poll_interval: 5              # Minimum poll interval in seconds
  log_path: ~/.hscc/daemon.log

logging:
  level: info                   # debug, info, warn, error
  path: ~/.hscc/daemon.log

skills:
  install_dir: ~/.hermes/skills
  # Skills to install (subset of Hermes bundled skills)
  skills:
    - brainstorming
    - caveman
    - executing-plans
    - systematic-debugging
    - test-driven-development
    - verification-before-completion
    - writing-plans

templates:
  install_dir: ~/.hermes/templates
  templates:
    - AGENTS.md
    - HEARTBEAT.md
    - IDENTITY.md
    - SOUL.md
    - TOOLS.md
    - USER.md

sparkrun:
  config: ~/.sparkrun-local/config.yaml
  recipes_dir: ~/.sparkrun-local/recipes

# Dashboard configuration (written to ~/.hermes/config.yaml by bootstrap)
dashboard:
  # Dashboard runs on the orchestrator/gateway node
  # Start with: hermes dashboard --host 0.0.0.0 --port 3000 --no-open
  # public_url is auto-set by bootstrap to http://<gateway>:3000
  # basic_auth:                  # Optional — add username/password_hash for auth
  #   username: admin
  #   password_hash: scrypt$...  # python -c "from plugins.dashboard_auth.basic import hash_password; print(hash_password('PW'))"
