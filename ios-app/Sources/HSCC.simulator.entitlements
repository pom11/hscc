<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- SIMULATOR ONLY (card W5g). Apple has not granted HSCC a CarPlay
	     entitlement, so the driving-task key lives here and nowhere else.
	     project.yml selects this file with
	     CODE_SIGN_ENTITLEMENTS[sdk=iphonesimulator*]; device/release builds
	     keep Sources/HSCC.entitlements byte for byte. The app-group and
	     keychain entries are repeated so the simulator build keeps the same
	     capabilities the device build has. -->
	<key>com.apple.developer.carplay-driving-task</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(HSCC_APP_GROUP)</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(HSCC_APP_GROUP)</string>
	</array>
</dict>
</plist>
