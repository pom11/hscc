<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for the HSCC daemon launchd job. launchctl does not expand ~ or
  $HOME, so paths must be absolute. launchd-setup.sh substitutes __HOME__ with
  the installing user's $HOME at install time. Do not edit the installed copy
  directly — edit this template and re-run launchd-setup.sh.
-->
<plist version="1.0">
<dict>
    <!-- Unique identifier for the service -->
    <key>Label</key>
    <string>com.hermes.hscc_daemon</string>

    <!-- Command to start the daemon. 'start-daemon' runs the loop in the
         FOREGROUND so launchd supervises it directly; 'start' would fork a child
         and exit, leaving launchd tracking the wrong (already-exited) process. -->
    <key>ProgramArguments</key>
    <array>
        <string>__PYBIN__</string>
        <string>__HOME__/.hermes/plugins/hscc_daemon/hscc.py</string>
        <string>start-daemon</string>
    </array>

    <!-- Working directory for the daemon -->
    <key>WorkingDirectory</key>
    <string>__HOME__</string>

    <!-- Route stdout and stderr to a single log file -->
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/hscc_daemon.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/hscc_daemon.log</string>

    <!-- Environment variables -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__HOME__/.hermes/hermes-agent/venv/bin:/opt/homebrew/bin:__HOME__/bin:/usr/local/bin:/System/Cryptexes/App/usr/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PYTHONPATH</key>
        <string>__HOME__/.hermes/plugins</string>
        <key>PYTHONDONTWRITEBYTECODE</key>
        <string>1</string>
    </dict>

    <!-- KeepAlive: restart on crash (not on clean exit via SIGTERM) -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- Start on login / initial load -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Timeout: if daemon doesn't exit within 10s of SIGTERM, force-kill -->
    <key>ExitTimeOut</key>
    <integer>10</integer>

    <!-- Process type: background daemon -->
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
