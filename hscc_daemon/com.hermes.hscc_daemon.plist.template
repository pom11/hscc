<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for the HSCC daemon launchd job. launchctl does not expand ~ or
  $HOME, so paths must be absolute. launchd-setup.sh substitutes __HOME__ with
  the installing user's $HOME at install time. Do not edit the installed copy
  directly — edit this template and re-run launchd-setup.sh.
-->
<plist version="1.0">
<dict>
    <!-- Unique identifier for the service -->
    <key>Label</key>
    <string>com.hermes.hscc_daemon</string>

    <!-- Command to start the daemon. 'start-daemon' runs the loop in the
         FOREGROUND so launchd supervises it directly; 'start' would fork a child
         and exit, leaving launchd tracking the wrong (already-exited) process. -->
    <key>ProgramArguments</key>
    <array>
        <string>__PYBIN__</string>
        <string>__HOME__/.hermes/plugins/hscc_daemon/hscc.py</string>
        <string>start-daemon</string>
    </array>

    <!-- Working directory for the daemon -->
    <key>WorkingDirectory</key>
    <string>__HOME__</string>

    <!-- Route stdout and stderr to a single log file -->
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/hscc_daemon.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/hscc_daemon.log</string>

    <!-- Environment variables -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <!-- t_b543e530: __HOME__/.local/bin is where the sparkrun CLI lives.
             A plist PATH that omits it made every sparkrun shell-out under
             launchd die with [Errno 2] (fleet status + worker auto-heal). The
             daemon now also resolves sparkrun PATH-independently, but the
             service environment must still be able to SEE the CLI for the
             shell=True call sites. Keep this list in step with
             install._daemon_path_env(). -->
        <string>__HOME__/.hermes/hermes-agent/venv/bin:__HOME__/.local/bin:/opt/homebrew/bin:__HOME__/bin:/usr/local/bin:/System/Cryptexes/App/usr/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PYTHONPATH</key>
        <string>__HOME__/.hermes/plugins</string>
        <key>PYTHONDONTWRITEBYTECODE</key>
        <string>1</string>
        <!-- t_6b5a5c61: launchd-setup.sh replaces this placeholder line with
             the tmux socket-dir key when the installing shell exports it (the
             daemon's orch-waker cannot see any pane without it), and removes
             the line when it does not. A generated plist never contains the
             placeholder. -->
        __TMUX_ENV__
    </dict>

    <!-- KeepAlive: restart on crash (not on clean exit via SIGTERM) -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- Start on login / initial load -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Timeout: if daemon doesn't exit within 10s of SIGTERM, force-kill -->
    <key>ExitTimeOut</key>
    <integer>10</integer>

    <!-- Process type: Standard, NOT Background (t_ae87b783, operator decision
         2026-11-25).  Background is a launchd job role that the OS applies to
         the whole job subtree: measured in a throwaway probe job on this host,
         a child of a Background job ran at `ps -o pri` 4 and 5.5 M it/s against
         20 and 39-42 M it/s under Standard — a ~7x tax on everything the daemon
         spawns, including every merge-queue gate leg (a 1323 s roster ran ~75
         min in the gate; docs/audits/merge-queue-gate-leg-timings_t_fdc2bff0.md).
         Nothing in user space can lift it back: `taskpolicy -c` parses only
         utility/background/maintenance and a `taskpolicy -c utility` child of a
         Background job measured pri 4 too.  Standard is the posture the fleet
         runs on; changing this key back costs every gate 3-7x silently, and
         hscc_daemon/tests/test_daemon_process_type_standard_t_ae87b783.py fails
         if a bootstrap ever does it. -->
    <key>ProcessType</key>
    <string>Standard</string>
</dict>
</plist>
